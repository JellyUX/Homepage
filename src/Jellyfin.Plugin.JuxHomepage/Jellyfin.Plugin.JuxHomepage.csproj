<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Version>0.1.0.0</Version>
    <RootNamespace>Jellyfin.Plugin.JuxHomepage</RootNamespace>
    <RepositoryUrl>https://github.com/JellyUX/Homepage</RepositoryUrl>
    <RepositoryType>GitHub</RepositoryType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- SDK the plugin compiles against: the declared minimum of a Jellyfin line (ci/jellyfin-lines.json).
         A build against a newer SDK references its assembly versions and fails to load on an older server.
         The default is the 10.11 line; -p:JellyfinVersion=12.0.0 builds the Jellyfin 12 line, which runs
         on .NET 10. CI also builds each line against its newest validated server. -->
    <JellyfinVersion Condition="'$(JellyfinVersion)' == ''">10.11.9</JellyfinVersion>
    <TargetFramework Condition="$(JellyfinVersion.StartsWith('10.'))">net9.0</TargetFramework>
    <TargetFramework Condition="!$(JellyfinVersion.StartsWith('10.'))">net10.0</TargetFramework>
    <DefineConstants Condition="!$(JellyfinVersion.StartsWith('10.'))">$(DefineConstants);JELLYFIN_12</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Jellyfin.Plugin.JuxHomepage.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Web\*.js" />
    <EmbeddedResource Include="Web\*.css" />
    <EmbeddedResource Include="Web\*.html" />
    <EmbeddedResource Include="Localization\*.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinVersion)" />
    <PackageReference Include="Jellyfin.Model" Version="$(JellyfinVersion)" />
    <PackageReference Include="Jellyfin.Extensions" Version="$(JellyfinVersion)" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.21" />
  </ItemGroup>

</Project>
