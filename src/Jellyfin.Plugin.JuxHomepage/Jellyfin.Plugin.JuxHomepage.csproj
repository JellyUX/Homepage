<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Version>0.1.0.0</Version>
    <RootNamespace>Jellyfin.Plugin.JuxHomepage</RootNamespace>
    <RepositoryUrl>https://github.com/JellyUX/Homepage</RepositoryUrl>
    <RepositoryType>GitHub</RepositoryType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- SDK the plugin compiles against: the declared minimum (build.yaml targetAbi). A build
         against a newer SDK references its assembly versions and fails to load on an older server.
         CI also builds against the newest validated server: -p:JellyfinVersion=10.11.10 -->
    <JellyfinVersion Condition="'$(JellyfinVersion)' == ''">10.11.9</JellyfinVersion>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Jellyfin.Plugin.JuxHomepage.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Web\jux-homepage.js" />
    <EmbeddedResource Include="Web\jux-ui.js" />
    <EmbeddedResource Include="Web\jux-ui.css" />
    <EmbeddedResource Include="Web\jux-tab-injector.js" />
    <EmbeddedResource Include="Web\jux-watchlist.js" />
    <EmbeddedResource Include="Web\jux-card-hooks.js" />
    <EmbeddedResource Include="Web\jux-progress.js" />
    <EmbeddedResource Include="Web\jux-history.js" />
    <EmbeddedResource Include="Web\jux-statistics.js" />
    <EmbeddedResource Include="Web\jux-series-flatten.js" />
    <EmbeddedResource Include="Web\jux-collections.js" />
    <EmbeddedResource Include="Web\jux-breadcrumb.js" />
    <EmbeddedResource Include="Web\jux-homepage.css" />
    <EmbeddedResource Include="Web\jux-loadsections-inject.js" />
    <EmbeddedResource Include="Web\config.html" />
    <EmbeddedResource Include="Web\config.css" />
    <EmbeddedResource Include="Localization\fr.json" />
    <EmbeddedResource Include="Localization\en.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinVersion)" />
    <PackageReference Include="Jellyfin.Model" Version="$(JellyfinVersion)" />
    <PackageReference Include="Jellyfin.Extensions" Version="$(JellyfinVersion)" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.0" />
  </ItemGroup>

</Project>
